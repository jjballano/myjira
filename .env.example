# Cada usuario entra con su email y API token desde la propia app.
# Opcional: fija el sitio de Jira (si no, se pide en el formulario; solo *.atlassian.net)
JIRA_BASE_URL=https://tu-empresa.atlassian.net

# Opcional, uso personal en local: credenciales que se usan cuando no hay sesión iniciada
# (con ellas puestas no aparece el formulario de login).
# https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_EMAIL=tu-email@empresa.com
# JIRA_API_TOKEN=

PORT=3101
